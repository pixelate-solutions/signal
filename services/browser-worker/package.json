{
  "name": "@signal/browser-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/host.js",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@signal/artifact-service": "workspace:*",
    "@signal/auth-sdk": "workspace:*",
    "@signal/connection-service": "workspace:*",
    "@signal/event-sdk": "workspace:*",
    "@signal/observability": "workspace:*",
    "@signal/persistence": "workspace:*",
    "@signal/tool-sdk": "workspace:*",
    "fastify": "^5.10.0",
    "ipaddr.js": "^2.4.0",
    "playwright-core": "^1.61.1",
    "zod": "catalog:"
  }
}
