aws_region  = "us-east-2"
dr_region   = "us-west-2"
environment = "staging"
eks_version = "1.33"
vpc_cidr    = "10.41.0.0/16"

domain_name             = "staging.signal.example.com"
route53_zone_id         = "Z0000000000000000000"
github_repository       = "pixelate-solutions/signal"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
platform_admin_role_arns = ["arn:aws:iam::123456789012:role/signal-platform-admin"]

# Set only to tightly controlled administrative networks when public EKS API access is necessary.
cluster_public_access_cidrs = []

tags = {
  Owner      = "platform"
  CostCenter = "signal"
}
