# Runtime
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=signal
PORT=3000
DEMO_MODE=true

# Data
DATABASE_URL=postgresql://signal:signal_dev_only@localhost:5432/signal
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=signal-local
S3_ACCESS_KEY_ID=signal-local
S3_SECRET_ACCESS_KEY=replace-me

# Durable workflows
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_TASKS=signal-tasks
TEMPORAL_TASK_QUEUE_BROWSER=signal-browser
TEMPORAL_TASK_QUEUE_SANDBOX=signal-sandbox
TEMPORAL_TASK_QUEUE_DOCUMENTS=signal-documents

# Identity
OIDC_ISSUER=http://localhost:8080/realms/signal
OIDC_CLIENT_ID=signal-api
OIDC_AUDIENCE=signal-api
OIDC_MOBILE_REDIRECT_URI=signal://oauth/callback

# Meta Model API
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_KEY=
META_MODEL_ID=meta/muse-spark-1.1
META_MODEL_API_VERSION=public-preview-2026-07

# Connections
COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_URL=http://localhost:3000/v1/connections/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_HANDLE=

# Policy and secrets
OPA_URL=http://localhost:8181
KMS_KEY_ID=local-development-key

# Push and observability
PUSH_PROVIDER=development
FIREBASE_SERVICE_ACCOUNT_JSON_HANDLE=
APNS_KEY_HANDLE=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Workers
CLAMAV_HOST=localhost
BROWSER_IMAGE=mcr.microsoft.com/playwright:v1.61.1-noble
SANDBOX_IMAGE=node:24-bookworm-slim
